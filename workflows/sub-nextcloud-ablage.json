        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zweck: die Wahrheit aus dem Nextcloud-Ordner lesen (Dateiliste), nicht aus den Antworten der Upload-Knoten.\n// Warum: eine Datei zaehlt nur, wenn sie im Ordner liegt und nicht leer ist; der Aufrufer bekommt genau ein Ergebnis.\nconst plan = $('Eingabe prüfen und Pfade bauen [Code]').first().json;\nconst liste = $input.all().map(function (i) { return i.json; });\nconst da = {};\nfor (const e of liste) {\n  if (e.type === 'file' && e.path) da[String(e.path).split('/').pop()] = Number(e.contentLength || 0);\n}\nconst soll = ['beitrag.md'];\nfor (const p of $('Eingabe prüfen und Pfade bauen [Code]').all()) {\n  if (p.json.file_name) soll.push(p.json.file_name);\n}\nconst fehlt = soll.filter(function (n) { return !(n in da) || da[n] <= 0; });\nlet fehlertext = '';\ntry {\n  for (const it of $('Ablage zusammenführen [Merge]').all()) {\n    if (it.json.error) { fehlertext = typeof it.json.error === 'string' ? it.json.error : JSON.stringify(it.json.error); break; }\n  }\n} catch (e) { fehlertext = ''; }\nconst gut = fehlt.length === 0;\nreturn [{ json: { ablage_ok: gut, ordner: plan.ordner, dateien: soll.length - fehlt.length, dateien_soll: soll.length, trace_id: plan.trace_id, post_id: plan.post_id, grund: gut ? '' : ('Nicht abgelegt: ' + fehlt.join(', ') + (fehlertext ? ' (' + fehlertext.slice(0, 160) + ')' : '')) } }];"
      }
    },
