    {
      "id": "18e660b6-aa67-4423-bc86-d03eac63a972",
      "name": "Bilder bereitstellen [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zweck: die Bild-Elemente MIT Binaerdaten wieder aufnehmen (Pfade aus der Pruefung, Binaerdaten direkt vom Trigger).\n// Warum: ohne Bild bekommt der Upload-Knoten kein Element, deshalb ein Marker keine_bilder.\nconst plan = $('Eingabe prüfen und Pfade bauen [Code]').all();\nconst roh = $('Beitrag von der Haupt-K1 [Execute Workflow Trigger]').all();\nconst bilder = [];\nplan.forEach(function (p, i) {\n  if (!p.json.datei_pfad) return;\n  const o = { json: p.json };\n  if (roh[i] && roh[i].binary) o.binary = roh[i].binary;\n  bilder.push(o);\n});\nif (!bilder.length) return [{ json: { keine_bilder: true } }];\nreturn bilder;"
      }
    },
