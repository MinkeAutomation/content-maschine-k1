    {
      "id": "780de2f4-2ee1-483a-aedd-20f7af866597",
      "name": "Fehler melden [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4480,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zweck: jeden Fehlerweg (Eingabe, Ordner, Beitragstext, Bilder) in dieselbe Antwort ok:false verwandeln.\n// Warum: der Aufrufer (Haupt-K1) soll nie abbrechen, er wertet nur das Feld ok aus.\nconst j = $input.first().json;\nlet plan = {};\ntry { plan = $('Eingabe prüfen und Pfade bauen [Code]').first().json || {}; } catch (e) { plan = {}; }\nlet grund = j.grund || '';\nif (!grund && j.error) grund = typeof j.error === 'string' ? j.error : JSON.stringify(j.error);\nif (!grund) grund = 'unbekannter Fehler';\nreturn [{ json: { ok: false, ordner: j.ordner || plan.ordner || '', dateien: j.dateien || 0, grund: String(grund).slice(0, 300), trace_id: j.trace_id || plan.trace_id || '', post_id: j.post_id || plan.post_id || '' } }];"
      }
    },
