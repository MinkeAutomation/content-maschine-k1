    {
      "id": "43faa672-780a-4bed-8dd8-ac164e4f9a60",
      "name": "Eingabe prüfen und Pfade bauen [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zweck: Eingabe des Aufrufers pruefen und alle Pfade genau einmal bauen.\n// Warum: bei ungueltiger Eingabe darf nichts in Nextcloud entstehen, der Aufrufer bekommt ok:false statt eines Absturzes.\n// Warum ohne Binaerdaten: die Bilder holt 'Bilder bereitstellen' direkt vom Trigger, so tragen die Ordner-Knoten keine Binaerdaten mit.\nconst alle = $input.all();\nconst m = alle.length ? alle[0].json : {};\nconst t = function (s) { return String(s == null ? '' : s).trim(); };\nconst slug = function (s, max) {\n  let x = t(s).toLowerCase();\n  const umlaute = [[228, 'ae'], [246, 'oe'], [252, 'ue'], [223, 'ss']];\n  for (const u of umlaute) { x = x.split(String.fromCharCode(u[0])).join(u[1]); }\n  return x.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, max).replace(/-+$/g, '');\n};\nconst kunde = t(m.customer_code);\nconst postId = t(m.post_id);\nconst kurz = postId.replace(/[^A-Za-z0-9]/g, '').slice(0, 8);\nconst thema = t(m.topic);\nconst trace = t(m.trace_id) || 'ohne-trace-id';\nlet grund = '';\nif (!/^[A-Za-z0-9_-]{1,40}$/.test(kunde)) grund = 'customer_code fehlt oder enthaelt unerlaubte Zeichen';\nelse if (!kurz) grund = 'post_id fehlt';\nelse if (!thema) grund = 'topic fehlt';\nlet anzahl = 0;\nfor (const it of alle) {\n  const f = t(it.json.file_name);\n  if (!f) continue;\n  anzahl++;\n  // Warum Whitelist: der Dateiname wird Teil des Nextcloud-Pfads, Unterordner oder Punkte-Tricks sind nicht erlaubt.\n  if (!grund && !/^[A-Za-z0-9_-]{1,60}[.](png|jpg|jpeg|webp)$/i.test(f)) grund = 'Dateiname ungueltig: ' + f.slice(0, 60);\n}\nif (grund) {\n  return [{ json: { eingabe_ok: false, grund: grund, trace_id: trace, post_id: postId } }];\n}\nconst datum = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });\nconst ordnerName = datum + '_' + kurz + '_' + (slug(thema, 40) || 'beitrag');\nconst wurzel = '/K1';\nconst kundeOrdner = wurzel + '/' + kunde;\nconst ordner = kundeOrdner + '/' + ordnerName;\nlet tags = m.hashtags;\nif (Array.isArray(tags)) {\n  tags = tags.map(function (x) { return String(x).trim(); }).filter(Boolean).map(function (x) { return x.startsWith('#') ? x : '#' + x; }).join(' ');\n}\ntags = t(tags);\nconst zeilen = ['# ' + thema, '', '- Kunde: ' + kunde, '- Beitrag: ' + postId, '- Thema: ' + thema, '- Datum: ' + datum, '- trace_id: ' + trace, '', '## Instagram-Text', '', t(m.caption_instagram), '', '## Hashtags', '', tags, '', '## LinkedIn-Text', '', t(m.linkedin_post), ''];\nconst text = zeilen.join(String.fromCharCode(10));\nreturn alle.map(function (it) {\n  const f = t(it.json.file_name);\n  return { json: { eingabe_ok: true, ordner: ordner, ordner_kunde: kundeOrdner, ordner_wurzel: wurzel, beitrag_pfad: ordner + '/beitrag.md', beitrag_text: text, bilder_anzahl: anzahl, trace_id: trace, post_id: postId, file_name: f, datei_pfad: f ? ordner + '/' + f : '' } };\n});"
      },
      "onError": "continueErrorOutput"
    },
