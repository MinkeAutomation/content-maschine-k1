    {
      "id": "a9de987c-50df-49b7-8452-60d37d06b673",
      "name": "Link auswerten [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4800,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zweck: aus der OCS-Antwort Freigabelink und Ablaufdatum lesen; jeder Fehler wird zu leerem Link plus Grund.\n// Warum: die Ablage selbst darf nie scheitern, nur weil der Link fehlt (ok bleibt unberuehrt).\nconst j = $input.first().json || {};\nconst d = j.ocs && j.ocs.data ? j.ocs.data : null;\nif (d && d.url) {\n  return [{ json: { freigabe_link: String(d.url), freigabe_ablauf: String(d.expiration || '').slice(0, 10), grund_link: '' } }];\n}\n// Warum nur Code und Kurztext: der volle Fehlerblock waere unlesbar lang.\nconst e = j.error && typeof j.error === 'object' ? j.error : {};\nlet g = '';\nif (e.httpCode || e.message) g = (e.httpCode ? 'HTTP ' + e.httpCode + ': ' : '') + String(e.message || '').slice(0, 120);\nelse if (typeof j.error === 'string') g = j.error.slice(0, 120);\nelse if (j.ocs && j.ocs.meta) g = 'OCS ' + j.ocs.meta.statuscode + ' ' + (j.ocs.meta.message || '');\nelse g = 'keine Link-Antwort von Nextcloud';\nreturn [{ json: { freigabe_link: '', freigabe_ablauf: '', grund_link: 'Freigabelink: ' + g } }];"
      }
    },
    {
      "id": "66768d3d-63e3-423a-ad60-3e3e97609402",
      "name": "Schritt 6a Freigabelink",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        4460,
        -200
      ],
      "parameters": {
        "content": "## ⑥a Freigabelink\nNach der Ablage erzeugt Nextcloud einen öffentlichen Link auf den Beitragsordner, nur lesend, gültig 30 Tage, ohne Passwort, damit der Kunde ihn direkt öffnet.\n🟡 Schlägt der Link fehl, bleibt ok unverändert, freigabe_link ist leer und grund_link nennt den Grund.\n🟡 Option später: ein Passwort kann als Feld password im Aufruf mitgegeben werden (Link dann nur mit Passwort offen).\n\n### 🟢 getestet, Lauf 941 und 945",
        "color": 1,
        "width": 940,
        "height": 190
      }
    }
